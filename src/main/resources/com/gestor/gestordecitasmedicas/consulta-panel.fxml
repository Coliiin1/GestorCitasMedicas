<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Panel "Consulta Médica - Diagnóstico y Receta" (Stitch df3f9d15...). Referencia en docs/stitch/consulta.png -->
<VBox styleClass="workspace" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestor.gestordecitasmedicas.ConsultaController">
    <HBox alignment="CENTER" styleClass="banner">
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-content" HBox.hgrow="ALWAYS">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="lblPaciente" styleClass="h-title" text="Sin cita seleccionada" />
                    <Label styleClass="badge-active" text="En Atención" />
                </HBox>
                <Label fx:id="lblResumen" styleClass="card-subtitle" text="Selecciona una cita desde la agenda para iniciar la consulta" />
            </VBox>
            <HBox alignment="CENTER" spacing="12.0" styleClass="timer-box">
                <Label fx:id="lblTimer" styleClass="timer" text="00:00 min" />
            </HBox>
            <Button fx:id="btnHistorial" onAction="#onHistorial" styleClass="btn-secondary" text="Ver Historial">
                <graphic><FontIcon iconLiteral="fi-rr-time-past" /></graphic>
            </Button>
        </HBox>
    </HBox>

    <!-- Pasos -->
    <HBox alignment="CENTER" spacing="8.0" styleClass="steps-bar">
        <Label styleClass="step-circle, step-circle-done">
            <graphic><FontIcon iconLiteral="fi-rr-check" iconSize="10" /></graphic>
        </Label>
        <Label styleClass="step-label" text="1. Recepción y Triaje" />
        <Separator prefWidth="32.0" />
        <Label styleClass="step-circle, step-circle-active" text="2" />
        <Label styleClass="step-label, step-label-active" text="2. Diagnóstico y Receta" />
        <Separator prefWidth="32.0" />
        <Label styleClass="step-circle" text="3" />
        <Label styleClass="step-label" text="3. Finalización y Firma" />
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox styleClass="page-body">
            <VBox styleClass="page-content" spacing="24.0">

                <VBox spacing="4.0">
                    <Label styleClass="title-section" text="Receta Médica y Prescripción Farmacológica" />
                    <Label styleClass="card-subtitle" text="Llene el diagnóstico principal y agregue los medicamentos que integrarán el informe final para el paciente." />
                    <Label fx:id="lblFechaEmision" styleClass="hint" text="Fecha de emisión: --" />
                </VBox>

                <VBox spacing="12.0" styleClass="card">
                    <Label styleClass="card-title" text="DIAGNÓSTICO CLÍNICO" />
                    <Separator />
                    <Label styleClass="caption" text="DIAGNÓSTICO PRINCIPAL / IMPRESIÓN DIAGNÓSTICA" />
                    <TextField fx:id="txtDiagnostico" promptText="Ej. Faringoamigdalitis aguda" styleClass="search-field" />
                    <Label styleClass="caption" text="EVOLUCIÓN CLÍNICA Y JUSTIFICACIÓN TERAPÉUTICA" />
                    <TextArea fx:id="txtEvolucion" prefRowCount="4" promptText="Describe la evolución clínica, exploración física y justificación del tratamiento..." styleClass="reason-area" wrapText="true" />
                </VBox>

                <VBox spacing="12.0" styleClass="card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="card-title" text="MEDICAMENTOS A RECETAR" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Label fx:id="lblMedicamentos" styleClass="hint" text="0 fármacos añadidos" />
                    </HBox>
                    <Separator />
                    <VBox fx:id="medicamentosBox" spacing="12.0" />
                    <Button fx:id="btnAgregarMedicamento" maxWidth="Infinity" onAction="#onAgregarMedicamento" styleClass="btn-dashed" text="Añadir un medicamento a la prescripción">
                        <graphic><FontIcon iconLiteral="fi-rr-plus" /></graphic>
                    </Button>
                </VBox>

                <VBox spacing="8.0" styleClass="card">
                    <Label styleClass="card-title" text="Medidas Generales, Cuidados y Signos de Alarma" />
                    <TextArea fx:id="txtIndicaciones" prefRowCount="3" promptText="Indicaciones generales, cuidados y signos de alarma para el paciente..." styleClass="reason-area" wrapText="true" />
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>

    <HBox alignment="CENTER" styleClass="page-footer">
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-content" HBox.hgrow="ALWAYS">
            <Button fx:id="btnVolver" onAction="#onVolver" styleClass="btn-secondary" text="Volver a Signos Vitales">
                <graphic><FontIcon iconLiteral="fi-rr-arrow-left" /></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnGuardarPdf" onAction="#onGuardarPdf" styleClass="btn-secondary" text="Guardar y Exportar Como PDF">
                <graphic><FontIcon iconLiteral="fi-rr-file-pdf" /></graphic>
            </Button>
            <Button fx:id="btnFinalizar" onAction="#onFinalizar" styleClass="btn-primary" text="Finalizar Consulta">
                <graphic><FontIcon iconLiteral="fi-rr-check" /></graphic>
            </Button>
        </HBox>
    </HBox>
</VBox>
