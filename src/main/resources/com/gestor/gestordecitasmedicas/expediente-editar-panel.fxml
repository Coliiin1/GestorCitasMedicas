<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Panel "Editar Expediente Clínico". Se abre desde el expediente del paciente. -->
<VBox styleClass="workspace" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestor.gestordecitasmedicas.ExpedienteEditarController">
    <ScrollPane fx:id="editorScroll" fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox styleClass="page-body">
            <VBox styleClass="edit-card, page-form">
                <VBox spacing="4.0" styleClass="edit-header">
                    <Label styleClass="panel-title" text="EDITAR EXPEDIENTE CLÍNICO" />
                    <Label fx:id="pacienteEditor" styleClass="card-subtitle" wrapText="true" />
                </VBox>

                <VBox fx:id="camposEditor" spacing="24.0" styleClass="form-body" />

                <VBox spacing="12.0" styleClass="form-actions">
                    <Label fx:id="errorEdicion" visible="false" managed="false" wrapText="true" styleClass="expediente-error" />
                    <HBox alignment="CENTER" spacing="12.0">
                        <Button onAction="#onCancelar" styleClass="btn-secondary" text="Volver al Expediente">
                            <graphic><FontIcon iconLiteral="fi-rr-arrow-left" /></graphic>
                        </Button>
                        <Button onAction="#onGuardar" prefWidth="260.0" styleClass="btn-primary" text="Guardar Expediente">
                            <graphic><FontIcon iconLiteral="fi-rr-check" /></graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
