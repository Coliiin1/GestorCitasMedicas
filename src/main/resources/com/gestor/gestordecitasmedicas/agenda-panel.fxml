<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Panel "Gestión de Citas" (Stitch e2ec849f...). Referencia en docs/stitch/citas.png. Calendario y agenda los llena AgendaController -->
<VBox styleClass="workspace" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestor.gestordecitasmedicas.AgendaController">
    <HBox alignment="CENTER" styleClass="page-header">
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-content" HBox.hgrow="ALWAYS">
            <VBox spacing="4.0" minWidth="0.0" HBox.hgrow="ALWAYS">
                <Label minWidth="0.0" styleClass="panel-title" text="GESTIÓN Y CONTROL DE CITAS MÉDICAS" wrapText="true" />
                <Label minWidth="0.0" styleClass="card-subtitle" text="Planificación semanal de consultas ambulatorias y triaje general" wrapText="true" />
            </VBox>
            <Button fx:id="btnConfigHorario" minWidth="-Infinity" onAction="#onConfigurarHorario" styleClass="btn-secondary" text="Horario y bloqueos">
                <graphic><FontIcon iconLiteral="fi-rr-settings" /></graphic>
            </Button>
            <Button fx:id="btnAgendar" minWidth="-Infinity" onAction="#onAgendarNueva" styleClass="btn-primary" text="Agendar Nueva Cita">
                <graphic><FontIcon iconLiteral="fi-rr-plus" /></graphic>
            </Button>
        </HBox>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox styleClass="page-body">
            <VBox styleClass="page-content" spacing="24.0">

                <FlowPane alignment="CENTER_LEFT" hgap="16.0" vgap="8.0" styleClass="card-flat">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Button onAction="#onSemanaAnterior" styleClass="btn-icon">
                            <graphic><FontIcon iconLiteral="fi-rr-angle-small-left" /></graphic>
                            <tooltip><Tooltip text="Semana anterior" /></tooltip>
                        </Button>
                        <Label fx:id="rangoLabel" minWidth="-Infinity" styleClass="row-name" text="Semana del 24 al 28 de Octubre, 2024" />
                        <Button onAction="#onSemanaSiguiente" styleClass="btn-icon">
                            <graphic><FontIcon iconLiteral="fi-rr-angle-small-right" /></graphic>
                            <tooltip><Tooltip text="Semana siguiente" /></tooltip>
                        </Button>
                        <Button fx:id="btnBloquearSemana" minWidth="-Infinity" onAction="#onBloquearSemana" styleClass="btn-secondary" text="Bloquear semana">
                            <graphic><FontIcon iconLiteral="fi-rr-cross" /></graphic>
                        </Button>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label minWidth="-Infinity" styleClass="caption" text="SEMÁFORO:" />
                        <Label minWidth="-Infinity" styleClass="chip, chip-green" text="Disponible">
                            <graphic><FontIcon iconLiteral="fi-rr-circle" iconSize="8" /></graphic>
                        </Label>
                        <Label minWidth="-Infinity" styleClass="chip, chip-amber" text="En Sala">
                            <graphic><FontIcon iconLiteral="fi-rr-circle" iconSize="8" /></graphic>
                        </Label>
                        <Label minWidth="-Infinity" styleClass="chip, chip-blood" text="Ocupado">
                            <graphic><FontIcon iconLiteral="fi-rr-circle" iconSize="8" /></graphic>
                        </Label>
                    </HBox>
                </FlowPane>

                <GridPane alignment="TOP_LEFT" hgap="24.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" maxWidth="340.0" minWidth="270.0" prefWidth="290.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" />
                    </columnConstraints>
                    <!-- Columna izquierda -->
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="24.0">
                        <VBox spacing="12.0" styleClass="card">
                            <Label maxWidth="Infinity" styleClass="caption" text="CALENDARIO MENSUAL" wrapText="true" />
                            <HBox alignment="CENTER" spacing="4.0">
                                <Button onAction="#onMesAnterior" styleClass="btn-icon">
                                    <graphic><FontIcon iconLiteral="fi-rr-angle-small-left" /></graphic>
                                    <tooltip><Tooltip text="Mes anterior" /></tooltip>
                                </Button>
                                <Label fx:id="mesLabel" alignment="CENTER" maxWidth="Infinity" minWidth="-Infinity" styleClass="row-name" text="Octubre 2024" HBox.hgrow="ALWAYS" />
                                <Button onAction="#onMesSiguiente" styleClass="btn-icon">
                                    <graphic><FontIcon iconLiteral="fi-rr-angle-small-right" /></graphic>
                                    <tooltip><Tooltip text="Mes siguiente" /></tooltip>
                                </Button>
                            </HBox>
                            <GridPane fx:id="calendario" hgap="4.0" maxWidth="Infinity" vgap="4.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="14.32" />
                                </columnConstraints>
                            </GridPane>
                            <Button fx:id="btnBloquearDia" maxWidth="Infinity" onAction="#onBloquearDia" styleClass="btn-secondary" text="Bloquear día">
                                <graphic><FontIcon iconLiteral="fi-rr-cross" /></graphic>
                            </Button>
                        </VBox>

                        <VBox spacing="12.0" styleClass="card">
                            <Label styleClass="caption" text="FICHA DE CITA SELECCIONADA" />
                            <Label maxWidth="Infinity" styleClass="hint" text="Turno en curso / Próximo a atender" wrapText="true" />
                            <Separator />
                            <Label styleClass="caption" text="NOMBRE DEL PACIENTE:" />
                            <TextField fx:id="fichaNombre" editable="false" styleClass="search-field" />
                            <Label fx:id="fichaEdad" maxWidth="Infinity" wrapText="true" styleClass="hint" text="Selecciona una cita de la agenda" />
                            <Label styleClass="caption" text="DATOS DE LA CITA:" />
                            <HBox><Label styleClass="hint" text="Fecha programada:" HBox.hgrow="ALWAYS" maxWidth="Infinity" /><Label fx:id="fichaFecha" styleClass="info-value" text="--" /></HBox>
                            <HBox><Label styleClass="hint" text="Hora de inicio:" HBox.hgrow="ALWAYS" maxWidth="Infinity" /><Label fx:id="fichaHora" styleClass="chip" text="--" /></HBox>
                            <Button fx:id="btnIniciar" maxWidth="Infinity" onAction="#onIniciarCita" styleClass="btn-primary" text="Iniciar Cita Clínica">
                                <graphic><FontIcon iconLiteral="fi-rr-play" /></graphic>
                            </Button>
                            <HBox spacing="8.0">
                                <Button fx:id="btnReprogramar" maxWidth="Infinity" minWidth="0.0" onAction="#onReprogramar" styleClass="btn-secondary" text="Reprogramar" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnCancelar" maxWidth="Infinity" minWidth="0.0" onAction="#onCancelarCita" styleClass="btn-secondary" text="Cancelar cita" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <Label maxWidth="Infinity" styleClass="hint" text="Abre el expediente clínico y módulo de diagnóstico" wrapText="true" />
                        </VBox>

                        <VBox spacing="8.0" styleClass="card">
                            <HBox><Label maxWidth="Infinity" styleClass="hint" text="Citas programadas hoy:" HBox.hgrow="ALWAYS" /><Label fx:id="hoyProgramadas" styleClass="info-value" text="0 pacientes" /></HBox>
                            <HBox><Label maxWidth="Infinity" styleClass="hint" text="Completadas:" HBox.hgrow="ALWAYS" /><Label fx:id="hoyCompletadas" styleClass="info-value" text="0 de 0 (0%)" /></HBox>
                        </VBox>
                    </VBox>

                    <!-- Agenda semanal -->
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS" minWidth="0.0" spacing="12.0" styleClass="card">
                        <Label styleClass="card-title" text="Agenda Semanal de Turnos Médicos" />
                        <Label maxWidth="Infinity" styleClass="card-subtitle" text="Haz clic en cualquier celda para ver la ficha o crear un turno rápido" wrapText="true" />
                        <GridPane fx:id="semana" hgap="4.0" vgap="4.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="64.0" prefWidth="64.0" maxWidth="64.0" />
                                <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0.0" minWidth="0.0" />
                                <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0.0" minWidth="0.0" />
                                <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0.0" minWidth="0.0" />
                                <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0.0" minWidth="0.0" />
                                <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0.0" minWidth="0.0" />
                            </columnConstraints>
                        </GridPane>
                        <Separator />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label fx:id="resumenLabel" maxWidth="Infinity" minWidth="0.0" wrapText="true" HBox.hgrow="ALWAYS" styleClass="hint" text="Resumen semanal: 0 atendidas · 0 agendadas · 0 canceladas · 30 libres" />
                        </HBox>
                    </VBox>
                </GridPane>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
