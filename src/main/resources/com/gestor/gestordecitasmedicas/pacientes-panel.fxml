<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Panel "Administración de Pacientes" (Stitch 78af5aaa...). Referencia en docs/stitch/pacientes.png -->
<VBox styleClass="workspace" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="16.0">
            <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>

            <VBox spacing="4.0">
                <Label styleClass="panel-title" text="ADMINISTRACIÓN DE PACIENTES" />
                <Label styleClass="card-subtitle" text="Padrón general de pacientes registrados, expedientes médicos y búsqueda rápida." />
            </VBox>

            <!-- Búsqueda y filtros -->
            <VBox spacing="10.0" styleClass="card">
                <HBox spacing="8.0">
                    <TextField promptText="Buscar Paciente por Nombre o CURP..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                    <Button styleClass="btn-primary-blue" text="Buscar" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label styleClass="hint" text="Filtros:" />
                    <Label styleClass="chip" text="Todos (142)" />
                    <Label styleClass="chip, chip-gray" text="Activos (128)" />
                    <Label styleClass="chip, chip-gray" text="Con cita hoy (8)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="hint" text="Búsqueda por coincidencia fonética y alfanumérica" />
                </HBox>
            </VBox>

            <!-- Tabla -->
            <VBox styleClass="card-flat">
                <HBox alignment="CENTER_LEFT" styleClass="table-head">
                    <Label minWidth="260.0" styleClass="caption" text="NOMBRE DEL PACIENTE" />
                    <Label minWidth="170.0" styleClass="caption" text="CURP" />
                    <Label minWidth="140.0" styleClass="caption" text="TELÉFONO / CONTACTO" />
                    <Label minWidth="120.0" styleClass="caption" text="ÚLTIMA CONSULTA" />
                    <Label minWidth="80.0" styleClass="caption" text="ESTADO" />
                    <Label alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="caption" text="ACCIONES" HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox alignment="CENTER_LEFT" styleClass="table-row">
                    <HBox alignment="CENTER_LEFT" minWidth="260.0" spacing="10.0"><Label styleClass="avatar" text="CM" /><VBox><Label styleClass="row-name" text="Carlos Alberto Mendoza Ruiz" /><Label styleClass="hint" text="Expediente: #EXP-0982" /></VBox></HBox>
                    <Label minWidth="170.0" styleClass="hint" text="MERC840912HDFNR03" />
                    <Label minWidth="140.0" styleClass="hint" text="+52 55 4192 8831" />
                    <Label minWidth="120.0" styleClass="hint" text="14 Oct 2024" />
                    <HBox minWidth="80.0"><Label styleClass="chip, chip-green" text="Activo" /></HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="6.0" HBox.hgrow="ALWAYS"><Button styleClass="btn-edit" text="Editar" /><Button styleClass="btn-del" text="Eliminar" /></HBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" styleClass="table-row">
                    <HBox alignment="CENTER_LEFT" minWidth="260.0" spacing="10.0"><Label styleClass="avatar" text="EN" /><VBox><Label styleClass="row-name" text="Elena Navarro Velázquez" /><Label styleClass="hint" text="Expediente: #EXP-1045" /></VBox></HBox>
                    <Label minWidth="170.0" styleClass="hint" text="NAVE910405MDFLL02" />
                    <Label minWidth="140.0" styleClass="hint" text="+52 55 7823 4901" />
                    <Label minWidth="120.0" styleClass="hint" text="02 Nov 2024" />
                    <HBox minWidth="80.0"><Label styleClass="chip, chip-green" text="Activo" /></HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="6.0" HBox.hgrow="ALWAYS"><Button styleClass="btn-edit" text="Editar" /><Button styleClass="btn-del" text="Eliminar" /></HBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" styleClass="table-row">
                    <HBox alignment="CENTER_LEFT" minWidth="260.0" spacing="10.0"><Label styleClass="avatar" text="RG" /><VBox><Label styleClass="row-name" text="Roberto Gómez Fernández" /><Label styleClass="hint" text="Expediente: #EXP-0872" /></VBox></HBox>
                    <Label minWidth="170.0" styleClass="hint" text="GOFR751218HJCR01" />
                    <Label minWidth="140.0" styleClass="hint" text="+52 33 1290 8472" />
                    <Label minWidth="120.0" styleClass="hint" text="22 Ene 2024" />
                    <HBox minWidth="80.0"><Label styleClass="chip, chip-amber" text="Inactivo" /></HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="6.0" HBox.hgrow="ALWAYS"><Button styleClass="btn-edit" text="Editar" /><Button styleClass="btn-del" text="Eliminar" /></HBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" styleClass="table-row">
                    <HBox alignment="CENTER_LEFT" minWidth="260.0" spacing="10.0"><Label styleClass="avatar" text="MV" /><VBox><Label styleClass="row-name" text="Miriam Valenzuela Castro" /><Label styleClass="hint" text="Expediente: #EXP-1120" /></VBox></HBox>
                    <Label minWidth="170.0" styleClass="hint" text="VACM980614MDFSM08" />
                    <Label minWidth="140.0" styleClass="hint" text="+52 55 6012 3499" />
                    <Label minWidth="120.0" styleClass="hint" text="Hoy, 10:30 AM" />
                    <HBox minWidth="80.0"><Label styleClass="chip, chip-green" text="Activo" /></HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="6.0" HBox.hgrow="ALWAYS"><Button styleClass="btn-edit" text="Editar" /><Button styleClass="btn-del" text="Eliminar" /></HBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" styleClass="table-row">
                    <HBox alignment="CENTER_LEFT" minWidth="260.0" spacing="10.0"><Label styleClass="avatar" text="JA" /><VBox><Label styleClass="row-name" text="Jorge Antonio Aguilar Ríos" /><Label styleClass="hint" text="Expediente: #EXP-1134" /></VBox></HBox>
                    <Label minWidth="170.0" styleClass="hint" text="AIRJ890102HDFNR09" />
                    <Label minWidth="140.0" styleClass="hint" text="+52 55 9012 8765" />
                    <Label minWidth="120.0" styleClass="hint" text="28 Oct 2024" />
                    <HBox minWidth="80.0"><Label styleClass="chip, chip-green" text="Activo" /></HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="6.0" HBox.hgrow="ALWAYS"><Button styleClass="btn-edit" text="Editar" /><Button styleClass="btn-del" text="Eliminar" /></HBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="table-head">
                    <Label styleClass="hint" text="Mostrando 5 de 142 pacientes registrados" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button styleClass="btn-edit" text="Anterior" />
                    <Button styleClass="btn-page-active" text="1" /><Button styleClass="btn-edit" text="2" /><Button styleClass="btn-edit" text="3" />
                    <Label styleClass="hint" text="..." />
                    <Button styleClass="btn-edit" text="29" /><Button styleClass="btn-edit" text="Siguiente" />
                    <Region minWidth="16.0" />
                    <Button styleClass="btn-edit" text="Exportar Excel" /><Button styleClass="btn-edit" text="PDF" />
                </HBox>
            </VBox>

            <Button maxWidth="Infinity" styleClass="btn-accent" text="+  Crear Nuevo Paciente" />
            <HBox alignment="CENTER" spacing="16.0">
                <Label styleClass="hint" text="Sistema: En Línea" />
                <Label styleClass="hint" text="Base de datos: SQL Server MediDesk" />
                <Label styleClass="hint" text="Cifrado: AES-256 Activo" />
                <Label styleClass="hint" text="Última sincronización: Hoy, hace 2 min" />
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
