<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Panel "Administración de Pacientes" (Stitch medical_appointments_design_system). Referencia en docs/stitch/. Solo interfaz. -->
<VBox styleClass="workspace" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox alignment="TOP_CENTER">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="28.0" /></padding>

            <VBox maxWidth="1152.0" spacing="20.0">
                <!-- Encabezado -->
                <VBox spacing="4.0" styleClass="panel-header">
                    <Label styleClass="panel-title" text="ADMINISTRACIÓN DE PACIENTES" />
                    <Label styleClass="card-subtitle" text="Padrón general de pacientes registrados, expedientes médicos y búsqueda rápida." />
                </VBox>

                <!-- Búsqueda -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
                    <TextField maxWidth="Infinity" prefHeight="42.0" promptText="Buscar Paciente por Nombre o CURP..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                    <Button prefHeight="42.0" prefWidth="104.0" styleClass="btn-primary-blue" text="Buscar" />
                </HBox>

                <!-- Listado -->
                <VBox spacing="12.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label maxWidth="Infinity" styleClass="list-caption" text="LISTADO DE PACIENTES REGISTRADOS" HBox.hgrow="ALWAYS" />
                        <Label styleClass="list-caption" text="5 REGISTROS MOSTRADOS" />
                    </HBox>

                    <!-- Carlos Alberto Mendoza Ruiz -->
                    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="patient-card">
                        <Label minHeight="44.0" minWidth="44.0" styleClass="avatar-lg" text="CM" />
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="patient-card-name" text="Carlos Alberto Mendoza Ruiz" />
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="patient-meta" text="Expediente: " />
                                <Label styleClass="meta-value" text="#EXP-0982" />
                                <Label styleClass="patient-meta" text="   •   CURP: " />
                                <Label styleClass="meta-mono" text="MERC840912HDFNR03" />
                                <Label styleClass="patient-meta" text="   •   Tel: " />
                                <Label styleClass="meta-value" text="+52 55 4192 8831" />
                            </HBox>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="14.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="patient-meta" text="Última consulta: " />
                                <Label styleClass="meta-value" text="14 Oct 2024" />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                <Button styleClass="btn-edit, nav-link" text="Editar" userData="paciente-editar-panel.fxml" />
                                <Button styleClass="btn-del" text="Eliminar" />
                            </HBox>
                        </HBox>
                    </HBox>

                    <!-- Elena Navarro Velázquez -->
                    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="patient-card">
                        <Label minHeight="44.0" minWidth="44.0" styleClass="avatar-lg" text="EN" />
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="patient-card-name" text="Elena Navarro Velázquez" />
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="patient-meta" text="Expediente: " />
                                <Label styleClass="meta-value" text="#EXP-1045" />
                                <Label styleClass="patient-meta" text="   •   CURP: " />
                                <Label styleClass="meta-mono" text="NAVE910405MDFLL02" />
                                <Label styleClass="patient-meta" text="   •   Tel: " />
                                <Label styleClass="meta-value" text="+52 55 7823 4901" />
                            </HBox>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="14.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="patient-meta" text="Última consulta: " />
                                <Label styleClass="meta-value" text="02 Nov 2024" />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                <Button styleClass="btn-edit, nav-link" text="Editar" userData="paciente-editar-panel.fxml" />
                                <Button styleClass="btn-del" text="Eliminar" />
                            </HBox>
                        </HBox>
                    </HBox>

                    <!-- Roberto Gómez Fernández -->
                    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="patient-card">
                        <Label minHeight="44.0" minWidth="44.0" styleClass="avatar-lg, avatar-amber" text="RG" />
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="patient-card-name" text="Roberto Gómez Fernández" />
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="patient-meta" text="Expediente: " />
                                <Label styleClass="meta-value" text="#EXP-0872" />
                                <Label styleClass="patient-meta" text="   •   CURP: " />
                                <Label styleClass="meta-mono" text="GOFR751218HJCR01" />
                                <Label styleClass="patient-meta" text="   •   Tel: " />
                                <Label styleClass="meta-value" text="+52 33 1290 8472" />
                            </HBox>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="14.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="patient-meta" text="Última consulta: " />
                                <Label styleClass="meta-value" text="22 Ene 2024" />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                <Button styleClass="btn-edit, nav-link" text="Editar" userData="paciente-editar-panel.fxml" />
                                <Button styleClass="btn-del" text="Eliminar" />
                            </HBox>
                        </HBox>
                    </HBox>

                    <!-- Miriam Valenzuela Castro -->
                    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="patient-card">
                        <Label minHeight="44.0" minWidth="44.0" styleClass="avatar-lg" text="MV" />
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="patient-card-name" text="Miriam Valenzuela Castro" />
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="patient-meta" text="Expediente: " />
                                <Label styleClass="meta-value" text="#EXP-1120" />
                                <Label styleClass="patient-meta" text="   •   CURP: " />
                                <Label styleClass="meta-mono" text="VACM980614MDFSM08" />
                                <Label styleClass="patient-meta" text="   •   Tel: " />
                                <Label styleClass="meta-value" text="+52 55 6012 3499" />
                            </HBox>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="14.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="patient-meta" text="Última consulta: " />
                                <Label styleClass="meta-value" text="Hoy, 10:30 AM" />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                <Button styleClass="btn-edit, nav-link" text="Editar" userData="paciente-editar-panel.fxml" />
                                <Button styleClass="btn-del" text="Eliminar" />
                            </HBox>
                        </HBox>
                    </HBox>

                    <!-- Jorge Antonio Aguilar Ríos -->
                    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="patient-card">
                        <Label minHeight="44.0" minWidth="44.0" styleClass="avatar-lg" text="JA" />
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="patient-card-name" text="Jorge Antonio Aguilar Ríos" />
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="patient-meta" text="Expediente: " />
                                <Label styleClass="meta-value" text="#EXP-1134" />
                                <Label styleClass="patient-meta" text="   •   CURP: " />
                                <Label styleClass="meta-mono" text="AIRJ890102HDFNR09" />
                                <Label styleClass="patient-meta" text="   •   Tel: " />
                                <Label styleClass="meta-value" text="+52 55 9012 8765" />
                            </HBox>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="14.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="patient-meta" text="Última consulta: " />
                                <Label styleClass="meta-value" text="28 Oct 2024" />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                <Button styleClass="btn-edit, nav-link" text="Editar" userData="paciente-editar-panel.fxml" />
                                <Button styleClass="btn-del" text="Eliminar" />
                            </HBox>
                        </HBox>
                    </HBox>

                    <!-- Paginación -->
                    <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="pager-card">
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="patient-meta" text="Mostrando " />
                            <Label styleClass="meta-value" text="5" />
                            <Label styleClass="patient-meta" text=" de " />
                            <Label styleClass="meta-value" text="142" />
                            <Label styleClass="patient-meta" text=" pacientes registrados" />
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button styleClass="pager-btn, pager-btn-muted" text="Anterior" />
                        <Button styleClass="pager-btn-active" text="1" />
                        <Button styleClass="pager-btn" text="2" />
                        <Button styleClass="pager-btn" text="3" />
                        <Label styleClass="patient-meta" text="…" />
                        <Button styleClass="pager-btn" text="29" />
                        <Button styleClass="pager-btn" text="Siguiente" />
                    </HBox>
                </VBox>

                <!-- Acción principal -->
                <Button maxWidth="Infinity" styleClass="btn-create" text="+   Crear Nuevo Paciente" />
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
