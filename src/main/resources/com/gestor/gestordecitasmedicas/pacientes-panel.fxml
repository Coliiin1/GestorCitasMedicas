<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Panel "Administración de Pacientes". Las tarjetas se generan desde la base de datos. -->
<VBox styleClass="workspace" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestor.gestordecitasmedicas.PacientesController">
    <HBox alignment="CENTER" styleClass="page-header">
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-content" HBox.hgrow="ALWAYS">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="panel-title" text="ADMINISTRACIÓN DE PACIENTES" />
                <Label styleClass="card-subtitle" text="Padrón general de pacientes registrados, expedientes médicos y búsqueda rápida." />
            </VBox>
            <Button fx:id="btnNuevo" onAction="#onNuevo" styleClass="btn-primary" text="Nuevo Paciente">
                <graphic><FontIcon iconLiteral="fi-rr-user-add" /></graphic>
            </Button>
        </HBox>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox styleClass="page-body">
            <VBox styleClass="page-content" spacing="24.0">

                <!-- Búsqueda -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
                    <TextField fx:id="txtBuscar" onAction="#onBuscar" maxWidth="Infinity" promptText="Buscar Paciente por Nombre o CURP..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="cmbOrden" prefWidth="160.0" styleClass="combo-field" />
                    <Button onAction="#onBuscar" prefWidth="104.0" styleClass="btn-primary" text="Buscar">
                        <graphic><FontIcon iconLiteral="fi-rr-search" /></graphic>
                    </Button>
                </HBox>

                <!-- Listado -->
                <VBox spacing="12.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label maxWidth="Infinity" styleClass="list-caption" text="LISTADO DE PACIENTES REGISTRADOS" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblContador" styleClass="list-caption" text="0 REGISTROS MOSTRADOS" />
                    </HBox>

                    <VBox fx:id="listaPacientes" spacing="12.0" />
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
