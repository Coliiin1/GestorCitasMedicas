<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Panel "Administración de Asistentes". Las filas se generan desde la base de datos. -->
<VBox styleClass="workspace" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestor.gestordecitasmedicas.AsistentesController">
    <HBox alignment="CENTER" styleClass="page-header">
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-content" HBox.hgrow="ALWAYS">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="panel-title" text="ADMINISTRACIÓN DE ASISTENTES" />
                <Label styleClass="card-subtitle" text="Control de usuarios y asistentes médicos registrados en el sistema clínico." />
            </VBox>
            <Button fx:id="btnNuevo" onAction="#onNuevo" styleClass="btn-primary" text="Nuevo Asistente">
                <graphic><FontIcon iconLiteral="fi-rr-user-add" /></graphic>
            </Button>
        </HBox>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox styleClass="page-body">
            <VBox styleClass="page-content" spacing="24.0">

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <TextField fx:id="txtBuscar" onAction="#onBuscar" maxWidth="Infinity" promptText="Buscar Asistente por Nombre..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                    <Button onAction="#onBuscar" styleClass="btn-primary" text="Buscar">
                        <graphic><FontIcon iconLiteral="fi-rr-search" /></graphic>
                    </Button>
                    <Label fx:id="lblContador" styleClass="chip, chip-green" text="Asistentes Registrados: 0">
                        <graphic><FontIcon iconLiteral="fi-rr-circle" iconSize="8" /></graphic>
                    </Label>
                </HBox>

                <VBox fx:id="listaAsistentes" spacing="12.0" />
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
