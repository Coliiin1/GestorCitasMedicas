<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Panel "Cita en curso" (Stitch 13443177082917861773 / c391534a...). Referencia en docs/stitch. Se inserta en main-view.fxml -->
<VBox styleClass="workspace" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestor.gestordecitasmedicas.CitaController">
        <!-- Encabezado de la cita -->
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="banner">
            <padding><Insets bottom="16.0" left="24.0" right="24.0" top="16.0" /></padding>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="badge-active" text="En Consulta Activa" />
                <HBox spacing="6.0">
                    <Label styleClass="h-title" text="Cita Actual:" />
                    <Label fx:id="lblPacienteBanner" styleClass="h-title-accent" text="Carlos Alberto Mendoza Ruiz" />
                </HBox>
            </VBox>
            <HBox alignment="CENTER" spacing="12.0" styleClass="timer-box">
                <VBox alignment="CENTER_RIGHT">
                    <Label styleClass="caption" text="DURACIÓN DE CONSULTA" />
                    <Label fx:id="lblTimer" styleClass="timer" text="00:00" />
                </VBox>
                <Separator orientation="VERTICAL" />
                <Button onAction="#onPausar" styleClass="icon-button" text="⏸">
                    <tooltip><Tooltip text="Pausar consulta" /></tooltip>
                </Button>
                <Button onAction="#onCancelar" styleClass="icon-button, icon-button-danger" text="✕">
                    <tooltip><Tooltip text="Cancelar consulta" /></tooltip>
                </Button>
            </HBox>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox spacing="24.0">
                <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>

                <!-- Identificación del paciente -->
                <VBox spacing="14.0" styleClass="card">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <HBox spacing="8.0">
                                <Label styleClass="chip" text="PACIENTE TITULAR" />
                                <Label styleClass="chip, chip-gray" text="Consulta General Presencial" />
                            </HBox>
                            <Label fx:id="lblPaciente" styleClass="patient-name" text="Carlos Alberto Mendoza Ruiz" />
                        </VBox>
                        <Button onAction="#onVerExpediente" styleClass="btn-dark" text="Consultar Expediente Clínico Completo" />
                    </HBox>
                    <Separator />
                    <HBox spacing="12.0">
                        <VBox spacing="4.0" styleClass="info-tile" HBox.hgrow="ALWAYS"><Label styleClass="caption" text="EDAD" /><Label fx:id="lblEdad" styleClass="info-value" text="38 años (Adulto)" /></VBox>
                        <VBox spacing="4.0" styleClass="info-tile" HBox.hgrow="ALWAYS"><Label styleClass="caption" text="FEC. NACIMIENTO" /><Label fx:id="lblNacimiento" styleClass="info-value" text="12/04/1985" /></VBox>
                        <VBox spacing="4.0" styleClass="info-tile" HBox.hgrow="ALWAYS"><Label styleClass="caption" text="CURP" /><Label fx:id="lblCurp" styleClass="info-value" text="MERC850412HDFNR03" /></VBox>
                        <VBox spacing="4.0" styleClass="info-tile" HBox.hgrow="ALWAYS"><Label styleClass="caption" text="SEXO / GÉNERO" /><Label fx:id="lblSexo" styleClass="info-value" text="Masculino" /></VBox>
                        <VBox spacing="4.0" styleClass="info-tile" HBox.hgrow="ALWAYS"><Label styleClass="caption" text="TIPO DE SANGRE" /><Label fx:id="lblSangre" styleClass="chip, chip-blood" text="O+ (Positivo)" /></VBox>
                        <VBox spacing="4.0" styleClass="info-tile" HBox.hgrow="ALWAYS"><Label styleClass="caption" text="ALERGIAS CONOCIDAS" /><Label fx:id="lblAlergias" styleClass="info-value" text="Ninguna reportada" /></VBox>
                    </HBox>
                </VBox>

                <!-- Signos vitales -->
                <VBox spacing="14.0" styleClass="card">
                    <Label styleClass="card-title" text="SIGNOS VITALES" />
                    <Separator />
                    <GridPane hgap="14.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        </columnConstraints>

                        <VBox spacing="4.0" styleClass="vital-tile" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label styleClass="caption" text="PRESIÓN ART." />
                            <HBox alignment="CENTER_RIGHT"><TextField fx:id="txtPresion" styleClass="vital-input" text="120/80" HBox.hgrow="ALWAYS" /><Label styleClass="unit" text=" mmHg" /></HBox>
                            <Label styleClass="hint" text="Sistólica / Diastólica" />
                        </VBox>
                        <VBox spacing="4.0" styleClass="vital-tile" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label styleClass="caption" text="FREC. CARDÍACA" />
                            <HBox alignment="CENTER_RIGHT"><TextField fx:id="txtFrecuencia" styleClass="vital-input" text="72" HBox.hgrow="ALWAYS" /><Label styleClass="unit" text=" lpm" /></HBox>
                            <Label styleClass="hint" text="Latidos por minuto" />
                        </VBox>
                        <VBox spacing="4.0" styleClass="vital-tile" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label styleClass="caption" text="OXÍGENO SPO2" />
                            <HBox alignment="CENTER_RIGHT"><TextField fx:id="txtOxigeno" styleClass="vital-input" text="98" HBox.hgrow="ALWAYS" /><Label styleClass="unit" text=" %" /></HBox>
                            <Label styleClass="hint" text="Saturación de oxígeno" />
                        </VBox>
                        <VBox spacing="4.0" styleClass="vital-tile" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <Label styleClass="caption" text="TEMPERATURA" />
                            <HBox alignment="CENTER_RIGHT"><TextField fx:id="txtTemperatura" styleClass="vital-input" text="36.6" HBox.hgrow="ALWAYS" /><Label styleClass="unit" text=" °C" /></HBox>
                            <Label styleClass="hint" text="Grados Celsius" />
                        </VBox>
                        <VBox spacing="4.0" styleClass="vital-tile" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label styleClass="caption" text="GLUCOSA" />
                            <HBox alignment="CENTER_RIGHT"><TextField fx:id="txtGlucosa" styleClass="vital-input" text="98" HBox.hgrow="ALWAYS" /><Label styleClass="unit" text=" mg/dL" /></HBox>
                            <Label styleClass="hint" text="Capilar / Ayuno" />
                        </VBox>
                        <VBox spacing="4.0" styleClass="vital-tile" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label styleClass="caption" text="PESO CORPORAL" />
                            <HBox alignment="CENTER_RIGHT"><TextField fx:id="txtPeso" styleClass="vital-input" text="74.2" HBox.hgrow="ALWAYS" /><Label styleClass="unit" text=" kg" /></HBox>
                            <Label styleClass="hint" text="Kilogramos" />
                        </VBox>
                        <VBox spacing="4.0" styleClass="vital-tile" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="1">
                            <Label styleClass="caption" text="ESTATURA &amp; IMC" />
                            <HBox alignment="CENTER" spacing="16.0">
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label styleClass="hint" text="Talla" />
                                    <HBox alignment="CENTER_RIGHT"><TextField fx:id="txtTalla" styleClass="vital-input" text="1.75" HBox.hgrow="ALWAYS" /><Label styleClass="unit" text=" m" /></HBox>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label styleClass="hint" text="IMC Calculado" />
                                    <Label fx:id="lblImc" styleClass="imc" text="--" />
                                </VBox>
                            </HBox>
                            <Label styleClass="hint" text="Formato: Talla en m (ej. 1.75)" />
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- Motivo de consulta -->
                <VBox spacing="10.0" styleClass="card">
                    <Label styleClass="card-title" text="MOTIVO PRINCIPAL DE LA CONSULTA / SÍNTOMAS REFERIDOS" />
                    <Label styleClass="card-subtitle" text="Anamnesis inicial y notas clínicas de ingreso" />
                    <Separator />
                    <TextArea fx:id="txtMotivo" prefRowCount="5" promptText="Describa el cuadro clínico presentado por el paciente, tiempo de evolución, antecedentes pertinentes y síntomas de alarma..." styleClass="reason-area" wrapText="true" />
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- Pie con pasos -->
        <HBox alignment="CENTER" spacing="12.0" styleClass="footer">
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="8.0">
                <Label styleClass="step-circle, step-circle-active" text="1" /><Label styleClass="step-label, step-label-active" text="Recepción y Triaje" />
                <Separator prefWidth="32.0" />
                <Label styleClass="step-circle" text="2" /><Label styleClass="step-label" text="Diagnóstico y Receta" />
                <Separator prefWidth="32.0" />
                <Label styleClass="step-circle" text="3" /><Label styleClass="step-label" text="Finalización y Firma" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button styleClass="btn-primary, nav-link" text="Siguiente  →" userData="consulta-panel.fxml" />
        </HBox>
</VBox>
